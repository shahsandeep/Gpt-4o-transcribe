# Frontend build-time configuration (all optional).
#
# The in-app backend switcher already knows the Python (:8000) and .NET (:8080)
# backends. By default their host is the same hostname the page is served from
# (localhost in dev), so you usually do NOT need to set anything here.
#
# Override only if your backends run on different hosts/ports than the defaults.
# Copy to `.env` (or `.env.local`) and Vite will pick these up at build time.

# VITE_PYTHON_HOST=localhost
# VITE_PYTHON_PORT=8000
# VITE_DOTNET_HOST=localhost
# VITE_DOTNET_PORT=8080
