# Shared Azure OpenAI configuration for BOTH backends.
# Copy to .env and fill in. Never commit .env.

# --- Azure OpenAI resource ---
# Works with either domain: https://<res>.openai.azure.com OR
# https://<res>.cognitiveservices.azure.com  (paste your full endpoint).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=

# --- Transcription deployment (gpt-4o-transcribe / gpt-4o-transcribe-diarize) ---
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
# Realtime WebSocket mode API version
AZURE_REALTIME_API_VERSION=2025-04-01-preview
# REST /audio/transcriptions mode API version (used by the REST modes)
AZURE_TRANSCRIBE_REST_API_VERSION=2025-04-01-preview
# REST response format. "auto" (default) auto-selects "diarized_json" when the
# deployment name contains "diarize" (so speakers work out of the box), else
# "json". Set explicitly to "json" / "diarized_json" / "text" to override.
AZURE_TRANSCRIBE_RESPONSE_FORMAT=auto

# --- Chat deployment used for translation (gpt-4o) ---
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_CHAT_API_VERSION=2024-10-21

# --- Server-side voice activity detection tuning (optional) ---
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=500

# --- Optional server-side ffmpeg audio enhancement (REST mode) ---
# Applied only when the UI's "Server enhance" toggle is on AND ffmpeg is found
# (it is in the Docker images). Falls back to the original audio otherwise.
AUDIO_ENHANCE_FILTERS=highpass=f=80,afftdn=nf=-25,loudnorm=I=-16:TP=-1.5:LRA=11

# Where to find ffmpeg if it's NOT on PATH. Point at the full path to the
# executable OR the folder that contains it (e.g. a portable/downloaded build).
# Leave empty to use "ffmpeg" from PATH. Do NOT wrap the value in quotes.
# Windows example (bin folder):
#   FFMPEG_PATH=C:\Users\you\Downloads\ffmpeg-7.1-full_build\bin
# Windows example (exe):
#   FFMPEG_PATH=C:\Users\you\Downloads\ffmpeg-7.1-full_build\bin\ffmpeg.exe
FFMPEG_PATH=

# --- Ports ---
PYTHON_PORT=8000
DOTNET_PORT=8080
