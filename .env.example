# Shared Azure OpenAI configuration for BOTH backends.
# Copy to .env and fill in. Never commit .env.

# --- Azure OpenAI resource ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=

# --- Transcription deployment (gpt-4o-transcribe) ---
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
# Realtime WebSocket mode API version
AZURE_REALTIME_API_VERSION=2025-04-01-preview
# REST /audio/transcriptions mode API version (used by the REST modes)
AZURE_TRANSCRIBE_REST_API_VERSION=2025-04-01-preview

# --- Chat deployment used for translation (gpt-4o) ---
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_CHAT_API_VERSION=2024-10-21

# --- Server-side voice activity detection tuning (optional) ---
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_DURATION_MS=500

# --- Ports ---
PYTHON_PORT=8000
DOTNET_PORT=8080
